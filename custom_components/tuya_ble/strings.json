{
  "config": {
    "abort": {
      "no_unconfigured_devices": "No unconfigured devices found."
    },
    "error": {
      "device_not_registered": "Device is not registered in Tuya cloud",
      "invalid_auth": "[%key:common::config_flow::error::invalid_auth%]",
      "login_error": "Login error ({code}): {msg}",
      "manual_required": "Required manual credential field is empty"
    },
    "flow_title": "{name}",
    "step": {
      "user": {
        "menu_options": {
          "manual": "Manual local BLE credentials (no Tuya cloud)",
          "login": "Tuya IoT cloud login"
        },
        "description": "Choose how to add this Tuya BLE device. Use manual local credentials when you already have the device_id/local_key/uuid/product details."
      },
      "device": {
        "data": {
          "address": "Tuya BLE device"
        },
        "description": "Select a discovered Tuya BLE device to set up after Tuya IoT cloud login."
      },
      "manual": {
        "data": {
          "address": "BLE MAC address",
          "uuid": "UUID",
          "local_key": "Local key",
          "device_id": "Device ID",
          "category": "Category",
          "product_id": "Product ID",
          "device_name": "Device name (optional)",
          "product_name": "Product name (optional)",
          "product_model": "Product model (optional)"
        },
        "description": "Enter locally extracted Tuya BLE credentials. This path does not contact Tuya IoT cloud. Device name defaults to the BLE address suffix; product name defaults to device name; product model defaults to product ID."
      },
      "login": {
        "data": {
          "access_id": "Tuya IoT Access ID",
          "access_secret": "Tuya IoT Access Secret",
          "country_code": "Country",
          "password": "[%key:common::config_flow::data::password%]",
          "username": "Account"
        },
        "description": "Tuya BLE requires obtaining encryption key from Tuya cloud. Almost all devices only need to access the cloud once during setup.\n\nRefer to documentation of Tuya integration to retrive the cloud credentials https://www.home-assistant.io/integrations/tuya/\n\nEnter your Tuya credentials."
      }
    }
  },
